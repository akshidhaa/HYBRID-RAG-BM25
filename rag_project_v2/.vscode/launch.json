{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: pipeline.py (demo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run: app.py (web UI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run: evaluate.py --mode sweep",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "args": ["--mode", "sweep"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run: evaluate.py --mode compare",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "args": ["--mode", "compare", "--threshold", "0.74"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
