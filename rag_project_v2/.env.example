# Copy this file to .env and fill in your values.
# .env is loaded automatically by app.py / pipeline.py / evaluate.py.
# Never commit your real .env file — it's already in .gitignore.

# Optional: enables ClaudeGenerator (LLM-based answers) instead of the
# extractive fallback. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: set to "1" to use real sentence-transformer embeddings for
# semantic search instead of TF-IDF/LSA (Phase 2 upgrade). Requires
# `pip install sentence-transformers`.
RAG_USE_EMBEDDINGS=0

# Optional: Flask session secret (a random one is generated if unset)
FLASK_SECRET_KEY=
